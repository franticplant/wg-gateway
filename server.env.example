# Base64 keys as produced by `wg genkey` / `wg pubkey`
SERVER_PRIVATE_KEY=
PEER_PUBLIC_KEY=

# Optional (defaults shown)
# WG_ADDRESS=10.77.0.1
# PEER_ADDRESS=10.77.0.2
# WG_PORT=51820
# MTU=1280
# VERBOSE=1         # log every proxied TCP/UDP connection
# ALLOW_PRIVATE=1   # let the client reach LAN/loopback/private ranges
